material SILICON :
   thermal conductivity     1.3e-4;
   volumetric heat capacity 1.61e-12;

material CU :
   thermal conductivity     3.85e-4;
   volumetric heat capacity 3.45e-12 ;
   
material TIM :
   thermal conductivity     5e-6 ;
   volumetric heat capacity 2.5e-12 ;
   
material BUMP :
   thermal conductivity     5.5e-6, 5.5e-6, 1.13e-4 ;
   volumetric heat capacity 1.845e-12 ; 
   
top heat sink :
   heat transfer coefficient 1.0e-7 ;
   temperature               300 ;

dimensions :
   chip length 13600, width 6600 ;
   cell length   50, width   50 ;
   non-uniform true;

die Bump1 :
   source  50 BUMP ;

die Bump2 :
   source  50 BUMP ;

die Chip :
   source  50 SILICON ;
   
die TIM_layer :
   source  7.5 TIM ;

die Interposer_layer :
   source  100 SILICON ;

die Heatsink_layer :
   source  50 CU ;

die PCB :
   source  250 SILICON ;

stack:
   die     Layer_1_1      Heatsink_layer    floorplan "./heatsink.flp";
   die     Layer_2_1      TIM_layer         floorplan "./TIM.flp";
   die     Layer_2_2      TIM_layer         floorplan "./TIM.flp";
   die     Layer_2_3      TIM_layer         floorplan "./TIM.flp";
   die     Layer_2_4      TIM_layer         floorplan "./TIM.flp";
   die     Layer_3_1      Chip              floorplan "./4chip.flp" ;
   die     Layer_3_2      Chip              floorplan "./4chip.flp" ;
   die     Layer_4_1      Bump1             floorplan "./bump1.flp" ;
   die     Layer_5_1      Interposer_layer  floorplan "./interposer.flp" ;
   die     Layer_6_1      Bump2             floorplan "./bump2.flp" ;
   die     Layer_7_1      PCB               floorplan "./pcb.flp" ;
   die     Layer_7_2      PCB               floorplan "./pcb.flp" ;
   die     Layer_7_3      PCB               floorplan "./pcb.flp" ;
   die     Layer_7_4      PCB               floorplan "./pcb.flp" ;

solver:
   steady ;
   initial temperature 300.0 ;
   type cpu_direct_lu ;
   numofcores 4 ;   

output:
T3d      (                             "polygon_ite8.vtk",           final  ) ;